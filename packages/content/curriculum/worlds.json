{
  "version": 1,
  "note": "The learning journey. Ten worlds, each a real communication capability rather than a topic heading. Levels never hard-list phrase ids - they name a category and a slice, and the build resolves them against the real phrase bank so the curriculum cannot drift from the corpus. A level referencing a category that does not exist fails CI.",

  "mission_types": {
    "recognise": { "label": "Match it", "effort": 1, "note": "Meaning to phrase. Lowest floor - works for every profile, and it is how a level opens." },
    "produce": { "label": "Say it your way", "effort": 3, "note": "Produce the phrase through whatever channel the learner uses. Speech, typing, signing, symbols, switch." },
    "choose_in_context": { "label": "What fits here", "effort": 2, "note": "A situation, three phrases, one that fits. This is the puzzle mechanic." },
    "order_the_steps": { "label": "Put it in order", "effort": 2, "note": "Sequence a short exchange. Tests structure rather than recall." },
    "scenario": { "label": "Live it", "effort": 4, "note": "A branching situation. Choices change what happens next." },
    "roleplay": { "label": "Talk it through", "effort": 5, "note": "Multi-turn conversation with the AI colleague, grounded in this world's phrases." },
    "interview": { "label": "The real thing", "effort": 6, "note": "Mock interview. Only appears in World 10." },
    "boss": { "label": "Show what you can do", "effort": 5, "note": "Mixed challenge closing a chapter. Draws from everything in it." }
  },

  "worlds": [
